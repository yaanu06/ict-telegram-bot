# Copy to .env locally and provide real values outside version control.
# The proxy reads these variables from its process environment.
TWELVE_DATA_API_KEY=
AI_PROVIDER=GEMINI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_API_KEY=
TVKIT_BASE_URL=http://127.0.0.1:8790
PROXY_CORS_ORIGIN=https://your-mini-app.example

# Keep the provider account below the Twelve Data Grow 55 allowance.
PROXY_TWELVE_GLOBAL_MAX_REQUESTS=50
PROXY_TWELVE_MAX_REQUESTS=50
PROXY_TVKIT_MAX_REQUESTS=120
PROXY_UPSTREAM_TIMEOUT_MS=40000

# Optional append-only audit persistence.
AUDIT_WRITE_TOKEN=
AUDIT_READ_TOKEN=
AUDIT_FILE_PATH=./server/data/audit.jsonl

# Optional official Tsinghua Kronos forecast layer.  The proxy keeps the
# Python worker resident; install the official shiyu-coder/Kronos repository
# and dependencies outside this repository, then point KRONOS_REPO_PATH at it.
KRONOS_ENABLED=true
KRONOS_MODEL_ID=NeoQuasar/Kronos-small
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_REPO_PATH=
KRONOS_PYTHON=
KRONOS_PYTHON_EXECUTABLE=
KRONOS_DEVICE=auto
KRONOS_MAX_CONTEXT=512
KRONOS_LOOKBACK=400
KRONOS_PATHS=1
KRONOS_SEED=42
KRONOS_1H_HORIZON=12
KRONOS_4H_HORIZON=6
KRONOS_TIMEOUT_MS=120000
# Render sets this true for background model loading after Node starts.
KRONOS_WARMUP=false
