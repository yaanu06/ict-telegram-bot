# Copy to .env locally and provide real values outside version control.
# The proxy reads these variables from its process environment.
TWELVE_DATA_API_KEY=
DEEPSEEK_API_KEY=
PROXY_CORS_ORIGIN=https://your-mini-app.example

# Keep the provider account below the Twelve Data Grow 55 allowance.
PROXY_TWELVE_GLOBAL_MAX_REQUESTS=50
PROXY_TWELVE_MAX_REQUESTS=50
PROXY_UPSTREAM_TIMEOUT_MS=10000

# Optional append-only audit persistence.
AUDIT_WRITE_TOKEN=
AUDIT_READ_TOKEN=
AUDIT_FILE_PATH=./server/data/audit.jsonl
